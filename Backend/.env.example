PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bgv
TAVILY_API_KEY=
SERPER_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ML_SERVICE_URL=http://127.0.0.1:8001
# optional tuning (defaults shown)
SEARCH_MAX_DISCOVERY_QUERIES=15
SEARCH_MAX_TARGETED_QUERIES=40
SEARCH_TARGETED_MIN_SCORE=30
TAVILY_MAX_RESULTS=20
SEARCH_ENRICH_IMAGES=true
SEARCH_IMAGE_ENRICH_MAX=
FINAL_MIN_OK_PROVIDER_CALLS=3
# profile enrichment (public sources only)
SEARCH_ENRICH_PROFILES=true
SEARCH_ENRICH_MAX=40
SEARCH_ENRICH_CONCURRENCY=4
SEARCH_ENRICH_TIMEOUT_MS=8000
# optional: raises the GitHub public-API rate limit
GITHUB_TOKEN=
# ranking
RANK_TIE_BAND=3
RANK_WEAK_FILL_BELOW=3
# per-platform discovery (every platform has its own target and counters)
PLATFORM_DISCOVERY=true
PLATFORM_DISCOVERY_TARGET=15
# optional per-platform override, e.g. {"LINKEDIN":25,"GITHUB":10}
PLATFORM_TARGETS=
# optional comma list to search only some platforms (default: all supported)
PLATFORM_DISCOVERY_PLATFORMS=
PLATFORM_MAX_QUERIES=4
PLATFORM_DISCOVERY_PAGES=2
PLATFORM_DISCOVERY_CONCURRENCY=3
# hard cap of provider calls spent by platform discovery in one run
PLATFORM_DISCOVERY_MAX_CALLS=600
# opt-in: true = skip platforms that already hold a confirmed profile (default false: fresh discovery always runs)
PLATFORM_DISCOVERY_SKIP_COVERED=false
# provider retries (429 / 5xx / timeouts only)
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=800

# --- Matching / ranking (all optional; defaults shown) ---
# Identity status thresholds (score 0-100 built only from independent evidence)
# MATCH_STRONG_MIN=80
# MATCH_POSSIBLE_MIN=60
# MATCH_REVIEW_MIN=45
# CONFLICT needs contradicting identity data worth this many points
# (company differs=1, country differs=1.5, title/city differ=0.3-0.5)
# MATCH_CONFLICT_POINTS=1.5
# MATCH_CONFLICT_POINTS_WITH_EVIDENCE=3
# MATCH_NOISY_CAP=35
# Ranking: identity-score band before the blended rank score (bigger = more tolerant ordering)
# RANK_IDENTITY_BAND=5

# ---- Performance / reliability (all optional; defaults shown) ----
# Search provider layer
# SEARCH_GLOBAL_CONCURRENCY=8        max simultaneous provider requests (all phases share it)
# PROVIDER_CACHE_TTL_MS=21600000     identical provider query is answered from memory for 6 h (0 = off)
# PROVIDER_CACHE_MAX=3000
# SEARCH_FALLBACK_MIN_PROFILES=5     state/country queries run only if exact-city queries found fewer name-matching profiles
# SEARCH_PARALLEL_PHASES=true        Phase 2 (targeted) and Phase 3 (per-platform) run together
# PLATFORM_DISCOVERY_CONCURRENCY=6
# PLATFORM_STALL_QUERIES=2           stop a platform after N queries with no new profile URL (0 = never)
# PLATFORM_DISCOVERY_TIME_BUDGET_MS=90000   wall-clock cap for platform discovery (0 = none)
# Reuse across runs of the same candidate
# PROFILE_REUSE_TTL_DAYS=14          stored enrichment younger than this is reused, not re-fetched
# ENRICH_TTL_DAYS=7                  re-enrich a profile only after this many days
# BGE-M3 client
# ML_CONCURRENCY=2                   simultaneous ML requests
# ML_BREAKER_THRESHOLD=2             consecutive failures before the ML service is treated as unavailable
# ML_BREAKER_COOLDOWN_MS=30000
# ML_RETRY_DELAY_MS=400              the ONE retry for a reset/5xx
# Logging
# PERF_LOG=true                      concise "[perf] ..." timing lines (counts and durations only)

# ---- Google Sheet -> candidates (optional; private sheet via service account) ----
# GOOGLE_SHEET_ID=            sheet id or the full sheet URL (a "#gid=" in the URL selects the tab)
# GOOGLE_SHEET_TAB=           tab name (default: tab from the URL gid, else the first tab)
# GOOGLE_SERVICE_ACCOUNT_JSON=  path to the key .json file (or the JSON itself) - keep it OUT of git
# (alternative) GOOGLE_SERVICE_ACCOUNT_EMAIL= and GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# SHEET_SYNC_INTERVAL_MIN=5   poll the sheet every N minutes (0 = only "Sync now"). Polling, not instant.
# SHEET_SEARCH_ENABLED=true   false = import + review only, the queue never searches
# SHEET_QUEUE_DELAY_MS=2000   pause between two candidates
# SHEET_QUEUE_CONCURRENCY=1   candidates searched at the same time (1-3; 1 = strictly one by one)
# SHEET_DATE_ORDER=MDY        how 1/15/2000 style dates are read (MDY or DMY)
# Import never starts a search. A reviewer must confirm candidates and press "Start sequential search".
